      "id": 8,
      "title": "Process Memory & Event Loop Lag",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "gigly_process_resident_memory_bytes",
          "legendFormat": "Resident Memory (RSS)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "gigly_nodejs_heap_size_used_bytes",
          "legendFormat": "Heap Size Used",
          "refId": "B"
